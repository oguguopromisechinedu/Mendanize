  @@index([status, createdAt])
}

model DuplicateCandidate {
  id               String          @id @default(cuid())
  jobId            String
  existingArticleId String
  similarityNote   String?
  createdAt        DateTime        @default(now())
  job              AIGenerationJob @relation(fields: [jobId], references: [id], onDelete: Cascade)
  existingArticle  Article         @relation(fields: [existingArticleId], references: [id], onDelete: Cascade)

  @@index([jobId])
  @@index([existingArticleId])
}

