model MetadataTemplate {
  id              String        @id @default(cuid())
  entityType      SeoEntityType
  name            String
  titleTemplate   String
  descriptionTemplate String    @db.Text
  isDefault       Boolean       @default(true)
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  @@unique([entityType, name])
  @@index([entityType])
}

model Redirect {
  id          String         @id @default(cuid())
  sourcePath  String
  destination String
  type        RedirectType   @default(PERMANENT_301)
  status      RedirectStatus @default(ACTIVE)
  notes       String?
  hitCount    Int            @default(0)
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt

  @@unique([sourcePath])
  @@index([status])
}

model StructuredData {
  id         String        @id @default(cuid())
  schemaType String
  entityType SeoEntityType?
  label      String
  jsonPreview Json
  enabled    Boolean       @default(true)
  sortOrder  Int           @default(0)
  createdAt  DateTime      @default(now())
  updatedAt  DateTime      @updatedAt

  @@index([schemaType])
}

model RobotsRule {
  id          String   @id @default(cuid())
  userAgent   String   @default("*")
  allowPath   String?
  disallowPath String?
  sortOrder   Int      @default(0)
  enabled     Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model SitemapConfiguration {
  id              String        @id @default(cuid())
  entityType      SeoEntityType
  included        Boolean       @default(true)
  changefreq      String        @default("weekly")
  priority        Float         @default(0.5)
  lastRegeneratedAt DateTime?
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  @@unique([entityType])
}

// === MES-016 Navigation Manager ===

enum MenuItemType {
  INTERNAL_PAGE
  ARTICLE
  CATEGORY
  TOPIC
  GUIDE
  AI_TOOL
  CUSTOM_URL
}

enum MenuLocationKey {
  MAIN
  MOBILE
  FOOTER
  UTILITY
  QUICK_LINKS
}

model NavigationSiteSettings {
  id              String   @id @default(cuid())
  key             String   @unique @default("main")
  brandName       String   @default("Mendanize")
  brandHref       String   @default("/")
  brandTagline    String?
  signInHref      String   @default("/sign-in")
  copyrightText   String?
  newsletterEnabled Boolean @default(true)
  newsletterHeadline String?
  newsletterPlaceholder String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
}

model NavigationMenu {
  id          String         @id @default(cuid())
  name        String
  slug        String         @unique
  description String?
  maxDepth    Int            @default(3)
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt
  items       MenuItem[]
  locations   MenuLocation[]
}

model MenuItem {
  id           String       @id @default(cuid())
  menuId       String
  parentId     String?
  label        String
  itemType     MenuItemType @default(INTERNAL_PAGE)
  href         String?
  entityId     String?
  icon         String?
  openInNewTab Boolean      @default(false)
  visible      Boolean      @default(true)
  badgeLabel   String?
  sortOrder    Int          @default(0)
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt
  menu         NavigationMenu @relation(fields: [menuId], references: [id], onDelete: Cascade)
  parent       MenuItem?    @relation("MenuItemTree", fields: [parentId], references: [id], onDelete: Cascade)
  children     MenuItem[]   @relation("MenuItemTree")

  @@index([menuId, sortOrder])
  @@index([parentId])
}

model MenuLocation {
  id          String          @id @default(cuid())
  key         MenuLocationKey @unique
  label       String
  menuId      String?
  columnTitle String?
  sortOrder   Int             @default(0)
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt
  menu        NavigationMenu? @relation(fields: [menuId], references: [id], onDelete: SetNull)

  @@index([key, sortOrder])
}

model SocialLink {
  id        String   @id @default(cuid())
  platform  String
  label     String
  href      String
  icon      String?
  visible   Boolean  @default(true)
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([sortOrder])
}

model LegalLink {
  id        String   @id @default(cuid())
  label     String
  href      String
  visible   Boolean  @default(true)
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([sortOrder])
}

// === MES-017 Search & Discovery ===

enum SearchFilterKind {
  CONTENT_TYPE
  CATEGORY
  TOPIC
  DIFFICULTY
  PUBLISH_DATE
  FEATURED
  RECENTLY_UPDATED
}

model SearchConfiguration {
  id                    String   @id @default(cuid())
  key                   String   @unique @default("main")
  enabled               Boolean  @default(true)
  minQueryLength        Int      @default(2)
  resultsPerPage        Int      @default(12)
  rankingRulesNote      String?  @db.Text
  synonymsPlaceholder   String?  @db.Text
  stopWordsPlaceholder  String?  @db.Text
  analyticsPlaceholder  String?  @db.Text
  includeArticles       Boolean  @default(true)
  includeGuides         Boolean  @default(true)
  includeTools          Boolean  @default(true)
  includeCategories     Boolean  @default(true)
  includeTopics         Boolean  @default(true)
