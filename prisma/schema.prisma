model TrendingSearch {
  id        String   @id @default(cuid())
  query     String   @unique
  score     Int      @default(0)
  active    Boolean  @default(true)
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([active, sortOrder])
}

model SearchSuggestion {
  id        String   @id @default(cuid())
  query     String
  label     String?
  active    Boolean  @default(true)
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([active, sortOrder])
}

model SearchFilter {
  id          String           @id @default(cuid())
  key         String           @unique
  label       String
  kind        SearchFilterKind
  enabled     Boolean          @default(true)
  sortOrder   Int              @default(0)
  optionsJson String?
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt

  @@index([enabled, sortOrder])
}

// === MES-018 Recommendations Engine ===
// UserInterest / SavedContent / LearningHistory: written by Personalization (MES-022),
// read by Recommendations. Single engine ù no parallel ranking elsewhere.

enum RecommendationEntityKind {
  ARTICLE
  GUIDE
  AI_TOOL
  CATEGORY
  TOPIC
}

model UserInterest {
  id           String     @id @default(cuid())
  publicUserId String
  categoryId   String?
  topicId      String?
  createdAt    DateTime   @default(now())
  publicUser   PublicUser @relation(fields: [publicUserId], references: [id], onDelete: Cascade)

  @@index([publicUserId])
  @@index([categoryId])
  @@index([topicId])
  @@unique([publicUserId, categoryId, topicId])
}

model SavedContent {
  id           String                   @id @default(cuid())
  publicUserId String
  entityType   RecommendationEntityKind
  entityId     String
  createdAt    DateTime                 @default(now())
  publicUser   PublicUser               @relation(fields: [publicUserId], references: [id], onDelete: Cascade)

  @@unique([publicUserId, entityType, entityId])
  @@index([publicUserId, createdAt])
}

model LearningHistory {
  id           String                   @id @default(cuid())
  publicUserId String
  entityType   RecommendationEntityKind
  entityId     String
  viewedAt     DateTime                 @default(now())
  publicUser   PublicUser               @relation(fields: [publicUserId], references: [id], onDelete: Cascade)

  @@index([publicUserId, viewedAt])
  @@index([entityType, entityId])
}

// === MES-022 User Learning Experience ===
// SavedArticle/Guide/AITool map to polymorphic SavedContent (MES-018).
// LearningProgress is placeholder until guide lesson completion exists.

model LearningGoal {
  id           String     @id @default(cuid())
  publicUserId String
  title        String
  description  String?
  targetNote   String?
  isActive     Boolean    @default(true)
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt
  publicUser   PublicUser @relation(fields: [publicUserId], references: [id], onDelete: Cascade)

  @@index([publicUserId, isActive])
}

model UserPreference {
  id                       String     @id @default(cuid())
  publicUserId             String     @unique
  preferredDifficulty      String     @default("INTERMEDIATE")
  dailyReminderEnabled     Boolean    @default(false)
  preferredCategoryIdsJson String?    @db.Text
  preferredTopicIdsJson    String?    @db.Text
  themePreference          String     @default("system")
  createdAt                DateTime   @default(now())
  updatedAt                DateTime   @updatedAt
  publicUser               PublicUser @relation(fields: [publicUserId], references: [id], onDelete: Cascade)
}

model LearningProgress {
  id                   String     @id @default(cuid())
  publicUserId         String
  guideId              String
  lastLessonTitle      String?
  completedLessons     Int        @default(0)
  totalLessons         Int        @default(5)
  estimatedMinutesLeft Int?
  percentComplete      Int        @default(0)
  lastOpenedAt         DateTime   @default(now())
  createdAt            DateTime   @default(now())
  updatedAt            DateTime   @updatedAt
  publicUser           PublicUser @relation(fields: [publicUserId], references: [id], onDelete: Cascade)

  @@unique([publicUserId, guideId])
  @@index([publicUserId, lastOpenedAt])
}

// === MES-019 Ask Mendanize AI ===

enum MessageRole {
  USER
  ASSISTANT
  SYSTEM
}

enum AskContextType {
  ARTICLE
  GUIDE
  AI_TOOL
  GENERAL
  HOMEPAGE
  /// MES-039 Career Hub ù Interview Coach + career prompt contexts
  INTERVIEW
  CAREER
  RESUME
  PROPOSAL
}

model Conversation {
  id              String         @id @default(cuid())
  publicUserId    String
  title           String         @default("New conversation")
  contextType     AskContextType @default(GENERAL)
  contextId       String?
  contextTitle    String?
  handoffId       String?
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt
  publicUser      PublicUser     @relation(fields: [publicUserId], references: [id], onDelete: Cascade)
  messages        Message[]
  feedback        AskFeedback[]

  @@index([publicUserId, updatedAt])
}

model Message {
  id             String       @id @default(cuid())
  conversationId String
  role           MessageRole
  content        String       @db.Text
  model          String?
  createdAt      DateTime     @default(now())
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  feedback       AskFeedback[]

  @@index([conversationId, createdAt])
}

/// Ask-specific templates (legacy PromptTemplate remains for workspace tools).
model AskPromptTemplate {
  id          String   @id @default(cuid())
  slug        String   @unique
  name        String
  description String?
  category    String   @default("general")
  promptText  String   @db.Text
  sortOrder   Int      @default(0)
  active      Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([active, sortOrder])
}

model AskFeedback {
  id             String        @id @default(cuid())
  userId         String?
  conversationId String?
  messageId      String?
  rating         Int
  comment        String?
  createdAt      DateTime      @default(now())
  conversation   Conversation? @relation(fields: [conversationId], references: [id], onDelete: SetNull)
  message        Message?      @relation(fields: [messageId], references: [id], onDelete: SetNull)

  @@index([conversationId])
  @@index([messageId])
}

/// Ephemeral Tier 1 ? Tier 2 handoff payload (expires quickly).
model AskHandoff {
  id           String         @id @default(cuid())
  question     String         @db.Text
  answer       String?        @db.Text
  contextType  AskContextType @default(GENERAL)
  contextId    String?
  contextTitle String?
  expiresAt    DateTime
  claimedAt    DateTime?
  createdAt    DateTime       @default(now())

  @@index([expiresAt])
}

