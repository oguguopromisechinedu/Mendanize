  PERMANENT_301
  TEMPORARY_302
}

enum RedirectStatus {
  ACTIVE
  DISABLED
}

enum SeoEntityType {
  HOMEPAGE
  ARTICLE
  CATEGORY
  TOPIC
  GUIDE
  AI_TOOL
  PAGE
}

model GlobalSEOSettings {
  id                   String   @id @default(cuid())
  key                  String   @unique @default("main")
  websiteTitle         String   @default("Mendanize")
  defaultMetaTitle     String?
  defaultMetaDescription String? @db.Text
  defaultOgImageUrl    String?
  defaultTwitterImageUrl String?
  brandName            String   @default("Mendanize")
  siteLanguage         String   @default("en")
  canonicalDomain      String?
  defaultRobotsIndex   Boolean  @default(true)
  defaultRobotsFollow  Boolean  @default(true)
  faviconUrl           String?
  appleTouchIconUrl    String?
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt
