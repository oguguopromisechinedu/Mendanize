  homepage            Homepage @relation(fields: [homepageId], references: [id], onDelete: Cascade)
}

model HomepageStatistic {
  id         String   @id @default(cuid())
  homepageId String
  key        String
  label      String
  value      String
  sortOrder  Int      @default(0)
  icon       String?
  homepage   Homepage @relation(fields: [homepageId], references: [id], onDelete: Cascade)

  @@index([homepageId, sortOrder])
}

model HomepageFAQ {
  id         String   @id @default(cuid())
  homepageId String
  question   String
  answer     String   @db.Text
  sortOrder  Int      @default(0)
  homepage   Homepage @relation(fields: [homepageId], references: [id], onDelete: Cascade)

  @@index([homepageId, sortOrder])
}

model HomepageCTA {
  id                String   @id @default(cuid())
  homepageId        String   @unique
  headline          String
  description       String   @db.Text
  primaryCtaLabel   String
  primaryCtaHref    String
  secondaryCtaLabel String
  secondaryCtaHref  String
  homepage          Homepage @relation(fields: [homepageId], references: [id], onDelete: Cascade)
}

model HomepageFeaturedContent {
  id            String                 @id @default(cuid())
  homepageId    String
  kind          HomepageFeaturedKind
  entityId      String
  sortOrder     Int                    @default(0)
  selectionMode HomepageSelectionMode  @default(MANUAL)
  titleOverride String?
  icon          String?
  iconColor     String?
  homepage      Homepage               @relation(fields: [homepageId], references: [id], onDelete: Cascade)

  @@index([homepageId, kind, sortOrder])
}

model HomepageTestimonial {
  id         String   @id @default(cuid())
  homepageId String
  quote      String   @db.Text
  name       String
  role       String
  sortOrder  Int      @default(0)
  homepage   Homepage @relation(fields: [homepageId], references: [id], onDelete: Cascade)

  @@index([homepageId, sortOrder])
}

// === MES-014 Media Library ===

enum AssetStatus {
  ACTIVE
  ARCHIVED
  PROCESSING
  FAILED
}

enum MediaVisibility {
  PUBLIC
  PRIVATE
  UNLISTED
}

model MediaCategory {
  id          String       @id @default(cuid())
  name        String
  slug        String       @unique
  description String?
  sortOrder   Int          @default(0)
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
  assets      MediaAsset[]
}

model MediaCollection {
  id          String                 @id @default(cuid())
  name        String
  slug        String                 @unique
  description String?
  sortOrder   Int                    @default(0)
  createdAt   DateTime               @default(now())
  updatedAt   DateTime               @updatedAt
  assets      MediaCollectionAsset[]
}

model MediaTag {
  id     String          @id @default(cuid())
  name   String
  slug   String          @unique
  assets MediaAssetTag[]
}

model MediaAsset {
  id              String                 @id @default(cuid())
  filename        String
  originalName    String?
  mimeType        String
  url             String
  storageKey      String?
  storageProvider String                 @default("placeholder")
  width           Int?
  height          Int?
  sizeBytes       Int?
  altText         String?
  caption         String?
  description     String?                @db.Text
  copyright       String?
  visibility      MediaVisibility        @default(PUBLIC)
  featured        Boolean                @default(false)
  status          AssetStatus            @default(ACTIVE)
  categoryId      String?
  lastUsedAt      DateTime?
  uploadedById    String?
  createdAt       DateTime               @default(now())
  updatedAt       DateTime               @updatedAt
  category        MediaCategory?         @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  tags            MediaAssetTag[]
  collections     MediaCollectionAsset[]
  usages          MediaUsage[]

  @@index([status])
  @@index([categoryId])
  @@index([createdAt])
  @@index([featured])
}

model MediaAssetTag {
  assetId String
  tagId   String
  asset   MediaAsset @relation(fields: [assetId], references: [id], onDelete: Cascade)
  tag     MediaTag   @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@id([assetId, tagId])
}

model MediaCollectionAsset {
  collectionId String
  assetId      String
  sortOrder    Int             @default(0)
  collection   MediaCollection @relation(fields: [collectionId], references: [id], onDelete: Cascade)
  asset        MediaAsset      @relation(fields: [assetId], references: [id], onDelete: Cascade)

  @@id([collectionId, assetId])
}

model MediaUsage {
  id         String     @id @default(cuid())
  assetId    String
  entityType String
  entityId   String
  field      String?
  createdAt  DateTime   @default(now())
  asset      MediaAsset @relation(fields: [assetId], references: [id], onDelete: Cascade)

  @@index([assetId])
  @@index([entityType, entityId])
}

