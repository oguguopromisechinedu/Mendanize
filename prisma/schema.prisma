// Mendanize - production database schema
// PostgreSQL + Prisma ORM

generator client {
  provider   = "prisma-client-js"
  engineType = "binary"
}

// Prisma 7: connection URLs live in prisma.config.ts (not here).
// Runtime (pooled): DATABASE_URL via lib/db/prisma.ts
// Migrations (direct): DIRECT_URL via prisma.config.ts datasource.url
datasource db {
  provider = "postgresql"
}

/// MES-030 admin RBAC role keys ù extendable via AdminRole rows.
enum AdminRoleKey {
  SUPER_ADMINISTRATOR
  ADMINISTRATOR
  EDITOR
  CONTENT_MANAGER
  ANALYTICS_MANAGER
  SUPPORT_MANAGER
}

/// @deprecated MES-030 ù kept only so the dual-auth migration can read legacy rows.
/// Remove after scripts/migrate-dual-auth.ts has been run and verified.
enum UserRole {
  USER
  LEARNER
  EDITOR
  ADMIN
  SUPER_ADMIN
}

enum PlanTier {
  FREE
  PRO
  TEAM
}

enum GenerationStatus {
  PENDING
  COMPLETED
  FAILED
}

enum NotificationType {
  INFO
  SUCCESS
  WARNING
  ERROR
  SECURITY
  SYSTEM
  LEARNING
  AI
  ANNOUNCEMENT
  BILLING
}

enum NotificationPriority {
  LOW
  NORMAL
  HIGH
  URGENT
}

enum NotificationStatus {
  UNREAD
  READ
  ARCHIVED
}

enum AnnouncementKind {
  PLATFORM
  MAINTENANCE
  FEATURE
  LEARNING
}

// === MES-030 Dual Authentication ===
// PublicUser = learners/subscribers (www). Admin = staff (/dashboard).
// Sessions are fully independent (PublicSession vs AdminSession).

model PublicUser {
  id            String    @id @default(cuid())
  name          String?
  email         String    @unique
  emailVerified DateTime?
  image         String?
  passwordHash  String?
  /// MES-035 ù analytics/cookie consent captured on the public site
  cookieConsentAt    DateTime?
  analyticsConsent   Boolean   @default(false)
  marketingConsent   Boolean   @default(false)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  accounts               Account[]
  sessions               PublicSession[]
  profile                Profile?
  subscription           Subscription?
  usageRecords           UsageRecord[]
  workspaces             WorkspaceMember[]
  chats                  Chat[]
  generations            Generation[]
  savedOutputs           SavedOutput[]
  projects               Project[]
  promptPresets          PromptPreset[]
  notifications          Notification[]
  notificationPreference NotificationPreference?
  communicationLogs      CommunicationLog[]
  settings               UserSettings?
  userInterests          UserInterest[]
  savedContents          SavedContent[]
  learningHistory        LearningHistory[]
  learningGoals          LearningGoal[]
  learningProgress       LearningProgress[]
  guideProgress          GuideProgress[]
  userPreference         UserPreference?
  conversations          Conversation[]
  certificates           Certificate[]
  achievementGrants      AchievementGrant[]
  learnerProjects        LearnerProject[]
  comments               Comment[]
  learningDailyStats     LearningDailyStat[]
  communityProfile       CommunityProfile?
  communityModeratorFlag CommunityModeratorFlag?
  discussions            Discussion[]
  discussionReplies      DiscussionReply[]
  discussionLikes        DiscussionLike[]
  studyGroupsOwned       StudyGroup[]            @relation("StudyGroupOwner")
  studyGroupMemberships  StudyGroupMember[]
  teamsOwned             Team[]                  @relation("TeamOwner")
  teamMemberships        TeamMember[]
  showcaseProjects       ShowcaseProject[]
  projectLikes           ProjectLike[]
  projectComments        ProjectComment[]
  projectBookmarks       ProjectBookmark[]
  communityReports       CommunityReport[]       @relation("CommunityReportReporter")
  /// MES-039 Professional Growth & Earnings
  clientFlag             ClientFlag?
  creatorFlag            CreatorFlag?
  assessmentAttempts     AssessmentAttempt[]
  promptLibraryEntries   PromptLibraryEntry[]
  learnerNotes           LearnerNote[]
  mentorshipsAsMentor    MentorshipRelationship[] @relation("MentorshipMentor")
  mentorshipsAsMentee    MentorshipRelationship[] @relation("MentorshipMentee")
  challengeSubmissions   ChallengeSubmission[]
  careerProfile          CareerProfile?
  interviewSessions      InterviewSession[]
  careerReadinessScores  CareerReadinessScore[]
  skillGapResults        SkillGapResult[]
  jobPostings            JobPosting[]
  jobApplications        JobApplication[]
  contractsAsClient      Contract[]               @relation("ContractClient")
  contractsAsWorker      Contract[]               @relation("ContractWorker")
  clientReviewsGiven     ClientReview[]           @relation("ClientReviewAuthor")
  clientReviewsReceived  ClientReview[]           @relation("ClientReviewSubject")
  marketplaceListings    MarketplaceListing[]
  marketplacePurchases   MarketplacePurchase[]
  marketplaceSubscriptions MarketplaceSubscriptionInstance[]
  creatorPayoutAccount   CreatorPayoutAccount?
  marketplaceReviews     MarketplaceReview[]
  creatorFollows         CreatorFollower[]        @relation("CreatorFollower")
  creatorFollowers       CreatorFollower[]        @relation("CreatorFollowed")
  reputationScore        ReputationScore?
}

model Admin {
  id            String    @id @default(cuid())
  name          String?
  email         String    @unique
  emailVerified DateTime?
  image         String?
  passwordHash  String?
  totpSecret    String?
  totpEnabled   Boolean   @default(false)
  active        Boolean   @default(true)
  roleId        String
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  role                   AdminRole                 @relation(fields: [roleId], references: [id], onDelete: Restrict)
  sessions               AdminSession[]
  posts                  Post[]
  articles               Article[]
  articleRevisions       ArticleRevision[]
  guides                 Guide[]
  guideRevisions         GuideRevision[]
  aiGenerations          AIGeneration[]
  notifications          Notification[]
  authorizationLogs      AuthorizationLog[]
  communityModeratorGrants CommunityModeratorFlag[] @relation("CommunityModeratorGrantedBy")
  communityReportResolutions CommunityReport[]     @relation("CommunityReportResolver")
}

model AdminRole {
  id          String       @id @default(cuid())
  key         AdminRoleKey @unique
  name        String
  description String?
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt

  admins      Admin[]
  permissions RolePermission[]
}

model Permission {
  id          String   @id @default(cuid())
  key         String   @unique
  name        String
  description String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  roles RolePermission[]
}

model RolePermission {
  roleId       String
  permissionId String
  role         AdminRole  @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission   Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@id([roleId, permissionId])
}

model PublicSession {
  id           String     @id @default(cuid())
  sessionToken String     @unique
  publicUserId String
  expires      DateTime
  publicUser   PublicUser @relation(fields: [publicUserId], references: [id], onDelete: Cascade)

  @@index([publicUserId])
}

model AdminSession {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  adminId      String
  expires      DateTime
  admin        Admin    @relation(fields: [adminId], references: [id], onDelete: Cascade)

  @@index([adminId])
}

model AuthorizationLog {
  id           String   @id @default(cuid())
  adminId      String?
  actorEmail   String?
  action       String
  entityType   String?
  entityId     String?
  summary      String
  metadataJson String?  @db.Text
  ipAddress    String?
  createdAt    DateTime @default(now())
  admin        Admin?   @relation(fields: [adminId], references: [id], onDelete: SetNull)

  @@index([createdAt])
  @@index([adminId])
  @@index([action])
}

/// OAuth accounts for PublicUser only (Admin never uses social/OAuth).
model Account {
  id                String  @id @default(cuid())
  publicUserId      String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  publicUser PublicUser @relation(fields: [publicUserId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@index([publicUserId])
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

model Profile {
  id           String     @id @default(cuid())
  publicUserId String     @unique
  bio          String?
  company      String?
  website      String?
  timezone     String?    @default("UTC")
  onboarded    Boolean    @default(false)
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt
  publicUser   PublicUser @relation(fields: [publicUserId], references: [id], onDelete: Cascade)
}

model Subscription {
  id                   String     @id @default(cuid())
  publicUserId         String     @unique
  plan                 PlanTier   @default(FREE)
  stripeCustomerId     String?    @unique
  stripeSubscriptionId String?    @unique
  stripePriceId        String?
  status               String     @default("active")
  currentPeriodEnd     DateTime?
  cancelAtPeriodEnd    Boolean    @default(false)
  createdAt            DateTime   @default(now())
  updatedAt            DateTime   @updatedAt
  publicUser           PublicUser @relation(fields: [publicUserId], references: [id], onDelete: Cascade)
}

model UsageRecord {
  id               String     @id @default(cuid())
  publicUserId     String
  month            String
  generationsCount Int        @default(0)
  tokensUsed       Int        @default(0)
  workspaceId      String?
  createdAt        DateTime   @default(now())
  updatedAt        DateTime   @updatedAt
  publicUser       PublicUser @relation(fields: [publicUserId], references: [id], onDelete: Cascade)

  @@unique([publicUserId, month])
}

model Workspace {
  id          String            @id @default(cuid())
  name        String
  slug        String            @unique
  description String?
  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt
  members     WorkspaceMember[]
  projects    Project[]
  chats       Chat[]
  generations Generation[]
}

model WorkspaceMember {
  id           String     @id @default(cuid())
  workspaceId  String
  publicUserId String
  role         String     @default("member")
  joinedAt     DateTime   @default(now())
  workspace    Workspace  @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  publicUser   PublicUser @relation(fields: [publicUserId], references: [id], onDelete: Cascade)

  @@unique([workspaceId, publicUserId])
}

model Project {
  id           String     @id @default(cuid())
  name         String
  description  String?
  publicUserId String
  workspaceId  String?
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt
  publicUser   PublicUser @relation(fields: [publicUserId], references: [id], onDelete: Cascade)
  workspace    Workspace? @relation(fields: [workspaceId], references: [id], onDelete: SetNull)
  generations  Generation[]
}

model Chat {
  id           String     @id @default(cuid())
  title        String     @default("New conversation")
  publicUserId String
  workspaceId  String?
  model        String     @default("gpt-4o-mini")
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt
  publicUser   PublicUser @relation(fields: [publicUserId], references: [id], onDelete: Cascade)
  workspace    Workspace? @relation(fields: [workspaceId], references: [id], onDelete: SetNull)
  messages     ChatMessage[]
}

model ChatMessage {
  id        String   @id @default(cuid())
  chatId    String
  role      String
  content   String   @db.Text
  model     String?
  tokens    Int?
  createdAt DateTime @default(now())
  chat      Chat     @relation(fields: [chatId], references: [id], onDelete: Cascade)
}

model Generation {
  id           String           @id @default(cuid())
  publicUserId String
  workspaceId  String?
  projectId    String?
  toolId       String
  prompt       String           @db.Text
  output       String?          @db.Text
  model        String           @default("gpt-4o-mini")
  status       GenerationStatus @default(PENDING)
  metadata     Json?
  createdAt    DateTime         @default(now())
  updatedAt    DateTime         @updatedAt
  publicUser   PublicUser       @relation(fields: [publicUserId], references: [id], onDelete: Cascade)
  workspace    Workspace?       @relation(fields: [workspaceId], references: [id], onDelete: SetNull)
  project      Project?         @relation(fields: [projectId], references: [id], onDelete: SetNull)
}

model SavedOutput {
  id           String     @id @default(cuid())
  publicUserId String
  title        String
  content      String     @db.Text
  toolId       String?
  tags         String[]
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt
  publicUser   PublicUser @relation(fields: [publicUserId], references: [id], onDelete: Cascade)
}

model PromptTemplate {
  id           String   @id @default(cuid())
  slug         String   @unique
  name         String
  description  String?
  category     String
  systemPrompt String   @db.Text
  userTemplate String   @db.Text
  variables    String[]
  isPublic     Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

model PromptPreset {
  id           String     @id @default(cuid())
  publicUserId String
  name         String
  content      String     @db.Text
  toolId       String?
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt
  publicUser   PublicUser @relation(fields: [publicUserId], references: [id], onDelete: Cascade)
}

model Notification {
  id           String               @id @default(cuid())
  publicUserId String?
  adminId      String?
  type         NotificationType     @default(INFO)
  priority     NotificationPriority @default(NORMAL)
  status       NotificationStatus   @default(UNREAD)
  title        String
  preview      String?
  body         String?
  read         Boolean              @default(false)
  archived     Boolean              @default(false)
  link         String?
  templateKey  String?
  createdAt    DateTime             @default(now())
  updatedAt    DateTime             @updatedAt
  publicUser   PublicUser?          @relation(fields: [publicUserId], references: [id], onDelete: Cascade)
  admin        Admin?               @relation(fields: [adminId], references: [id], onDelete: Cascade)

  @@index([publicUserId, createdAt])
  @@index([publicUserId, status])
  @@index([adminId, createdAt])
  @@index([type])
}

model NotificationPreference {
  id               String     @id @default(cuid())
  publicUserId     String     @unique
  learningUpdates  Boolean    @default(true)
  aiUpdates        Boolean    @default(true)
  securityAlerts   Boolean    @default(true)
  newsletter       Boolean    @default(false)
  productUpdates   Boolean    @default(true)
  announcements    Boolean    @default(true)
  createdAt        DateTime   @default(now())
  updatedAt        DateTime   @updatedAt
  publicUser       PublicUser @relation(fields: [publicUserId], references: [id], onDelete: Cascade)
}

model NotificationTemplate {
  id          String           @id @default(cuid())
  key         String           @unique
  name        String
  type        NotificationType @default(INFO)
  titleTpl    String
  bodyTpl     String           @db.Text
  priority    NotificationPriority @default(NORMAL)
  active      Boolean          @default(true)
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt
}

model EmailTemplate {
  id          String   @id @default(cuid())
  key         String   @unique
  name        String
  subject     String
  bodyHtml    String   @db.Text
  bodyText    String?  @db.Text
  description String?
  active      Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model Announcement {
  id          String          @id @default(cuid())
  kind        AnnouncementKind @default(PLATFORM)
  title       String
  body        String          @db.Text
  active      Boolean         @default(true)
  startsAt    DateTime?
  endsAt      DateTime?
  link        String?
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt

  @@index([active, startsAt])
}

model CommunicationLog {
  id           String      @id @default(cuid())
  publicUserId String?
  channel      String
  templateKey  String?
  subject      String?
  status       String      @default("queued")
  detail       String?     @db.Text
  createdAt    DateTime    @default(now())
  publicUser   PublicUser? @relation(fields: [publicUserId], references: [id], onDelete: SetNull)

  @@index([createdAt])
  @@index([publicUserId, createdAt])
  @@index([channel, status])
}

model DeliverySetting {
  id              String   @id @default(cuid())
  key             String   @unique @default("main")
  inAppEnabled    Boolean  @default(true)
  emailEnabled    Boolean  @default(true)
  browserPushEnabled Boolean @default(false)
  smsEnabled      Boolean  @default(false)
  smtpNote        String?  @db.Text
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
}

model UserSettings {
  id              String     @id @default(cuid())
  publicUserId    String     @unique
  defaultModel    String     @default("gpt-4o-mini")
  emailDigest     Boolean    @default(true)
  marketingEmails Boolean    @default(false)
  theme           String     @default("dark")
  publicUser      PublicUser @relation(fields: [publicUserId], references: [id], onDelete: Cascade)
}

model FeatureFlag {
  id          String   @id @default(cuid())
  key         String   @unique
  label       String   @default("")
  description String?
  enabled     Boolean  @default(false)
  sortOrder   Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([sortOrder])
}

// === Blog Platform Models ===

enum PostStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}

enum CategoryStatus {
  DRAFT
  ACTIVE
  HIDDEN
  ARCHIVED
}

enum TopicStatus {
  DRAFT
  ACTIVE
  HIDDEN
  ARCHIVED
}

model Category {
  id             String           @id @default(cuid())
  name           String           @unique
  slug           String           @unique
  description    String?
  icon           String?
  accentColor    String?
  status         CategoryStatus   @default(ACTIVE)
  featured       Boolean          @default(false)
  displayOrder   Int              @default(0)
  seoTitle       String?
  seoDescription String?
  focusKeyword   String?
  canonicalUrl   String?
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt
  posts          Post[]
  articles       Article[]
  topics         Topic[]
  guides         Guide[]
  toolRelations  ToolCategoryRelation[]
  image          CategoryImage?

  @@index([status])
  @@index([displayOrder])
}

model CategoryImage {
  id         String   @id @default(cuid())
  url        String
  alt        String?
  categoryId String   @unique
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
  category   Category @relation(fields: [categoryId], references: [id], onDelete: Cascade)
}

model Topic {
  id             String        @id @default(cuid())
  name           String        @unique
  slug           String        @unique
  description    String?
  categoryId     String
  status         TopicStatus   @default(ACTIVE)
  featured       Boolean       @default(false)
  displayOrder   Int           @default(0)
  seoTitle       String?
  seoDescription String?
  focusKeyword   String?
  canonicalUrl   String?
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt
  category       Category      @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  articles       Article[]
  guides         Guide[]
  toolRelations  ToolTopicRelation[]
  image          TopicImage?

  @@index([categoryId])
  @@index([status])
  @@index([displayOrder])
}

model TopicImage {
  id        String   @id @default(cuid())
  url       String
  alt       String?
  topicId   String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  topic     Topic    @relation(fields: [topicId], references: [id], onDelete: Cascade)
}

model Tag {
  id          String        @id @default(cuid())
  name        String        @unique
  slug        String        @unique
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt
  postTags    PostTag[]
  articleTags ArticleTag[]
  toolTags    ToolTag[]
}

// === MES-008 Article CMS ===

enum ArticleStatus {
  DRAFT
  AI_DRAFT
  REVIEW
  SCHEDULED
  PUBLISHED
  ARCHIVED
}

model Article {
  id               String         @id @default(cuid())
  title            String
  slug             String         @unique
  excerpt          String?
  content          String         @db.Text
  status           ArticleStatus  @default(DRAFT)
  featured         Boolean        @default(false)
  readingTimeMin   Int            @default(1)
  authorId         String
  categoryId       String?
  topicId          String?
  publishedAt      DateTime?
  scheduledAt      DateTime?
  viewCount        Int            @default(0)
  // SEO (SEO Service consumption)
  seoTitle         String?
  seoDescription   String?
  focusKeyword     String?
  canonicalUrl     String?
  socialImageUrl   String?
  createdAt        DateTime       @default(now())
  updatedAt        DateTime       @updatedAt

  author           Admin          @relation(fields: [authorId], references: [id], onDelete: Cascade)
  category         Category?      @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  topic            Topic?         @relation(fields: [topicId], references: [id], onDelete: SetNull)
  tags             ArticleTag[]
  featuredImage    FeaturedImage?
  revisions        ArticleRevision[]
  aiGenerationJobs AIGenerationJob[]
  duplicateHits    DuplicateCandidate[]

  @@index([status])
  @@index([publishedAt])
  @@index([authorId])
}

model FeaturedImage {
  id        String   @id @default(cuid())
  url       String
  alt       String?
  articleId String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  article   Article  @relation(fields: [articleId], references: [id], onDelete: Cascade)
}

model ArticleTag {
  articleId String
  tagId     String
  article   Article @relation(fields: [articleId], references: [id], onDelete: Cascade)
  tag       Tag     @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@id([articleId, tagId])
}

/// Architecture only in MES-008 ù no version-history UI yet.
model ArticleRevision {
  id          String   @id @default(cuid())
  articleId   String
  title       String
  content     String   @db.Text
  excerpt     String?
  createdById String?
  createdAt   DateTime @default(now())
  article     Article  @relation(fields: [articleId], references: [id], onDelete: Cascade)
  createdBy   Admin?   @relation(fields: [createdById], references: [id], onDelete: SetNull)

  @@index([articleId])
}

// === MES-010 Learning Guides ===

enum GuideStatus {
  DRAFT
  REVIEW
  SCHEDULED
  PUBLISHED
  ARCHIVED
}

enum GuideDifficulty {
  BEGINNER
  INTERMEDIATE
  ADVANCED
}

model Guide {
  id                    String          @id @default(cuid())
  title                 String
  slug                  String          @unique
  shortDescription      String?
  fullDescription       String?         @db.Text
  coverImageUrl         String?
  coverImageAlt         String?
  status                GuideStatus     @default(DRAFT)
  difficulty            GuideDifficulty @default(BEGINNER)
  estimatedMinutes      Int             @default(30)
  learningObjectives    String[]        @default([])
  prerequisites         String[]        @default([])
  featured              Boolean         @default(false)
  authorId              String
  categoryId            String?
  topicId               String
  publishedAt           DateTime?
  scheduledAt           DateTime?
  seoTitle              String?
  seoDescription        String?
  focusKeyword          String?
  canonicalUrl          String?
  createdAt             DateTime        @default(now())
  updatedAt             DateTime        @updatedAt

  author                Admin           @relation(fields: [authorId], references: [id], onDelete: Cascade)
  category              Category?       @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  topic                 Topic           @relation(fields: [topicId], references: [id], onDelete: Restrict)
  sections              GuideSection[]
  revisions             GuideRevision[]
  progressRecords       GuideProgress[]
  certificateTemplates  CertificateTemplate[]
  workspacePresets      WorkspacePreset[]
  showcaseProjects      ShowcaseProject[]
  assessments           Assessment[]
  learnerNotes          LearnerNote[]

  @@index([status])
  @@index([topicId])
  @@index([authorId])
  @@index([publishedAt])
}

model GuideSection {
  id          String        @id @default(cuid())
  guideId     String
  title       String
  slug        String
  description String?
  sortOrder   Int           @default(0)
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt
  guide       Guide         @relation(fields: [guideId], references: [id], onDelete: Cascade)
  lessons     GuideLesson[]

  @@unique([guideId, slug])
  @@index([guideId, sortOrder])
}

model GuideLesson {
  id              String       @id @default(cuid())
  sectionId       String
  title           String
  slug            String
  content         String       @db.Text @default("")
  readingTimeMin  Int          @default(1)
  featuredImageUrl String?
  featuredImageAlt String?
  /// Placeholders until Media / AI Tools deeper wiring
  videoUrl        String?
  codeExample     String?      @db.Text
  resourceUrl     String?
  articleId       String?
  aiToolId        String?
  sortOrder       Int          @default(0)
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt
  section         GuideSection @relation(fields: [sectionId], references: [id], onDelete: Cascade)

  @@unique([sectionId, slug])
  @@index([sectionId, sortOrder])
}

/// Architecture only ù version-history UI not in MES-010.
model GuideRevision {
  id          String   @id @default(cuid())
  guideId     String
  title       String
  snapshot    String   @db.Text
  createdById String?
  createdAt   DateTime @default(now())
  guide       Guide    @relation(fields: [guideId], references: [id], onDelete: Cascade)
  createdBy   Admin?   @relation(fields: [createdById], references: [id], onDelete: SetNull)

  @@index([guideId])
}

/// Modeled for MES-022 personalization ù not implemented in MES-010.
model GuideProgress {
  id                 String     @id @default(cuid())
  publicUserId       String
  guideId            String
  completedLessonIds String[]   @default([])
  percentComplete    Int        @default(0)
  lastLessonId       String?
  startedAt          DateTime   @default(now())
  completedAt        DateTime?
  updatedAt          DateTime   @updatedAt
  guide              Guide      @relation(fields: [guideId], references: [id], onDelete: Cascade)
  publicUser         PublicUser @relation(fields: [publicUserId], references: [id], onDelete: Cascade)

  @@unique([publicUserId, guideId])
  @@index([guideId])
}

model Post {
  id            String      @id @default(cuid())
  title         String
  slug          String      @unique
  content       String      @db.Text
  excerpt       String?
  featuredImage String?
  authorId      String
  categoryId    String?
  status        PostStatus  @default(DRAFT)
  viewCount     Int         @default(0)
  publishedAt   DateTime?
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt
  
  // SEO fields
  seoTitle      String?
  seoDescription String?
  seoKeywords   String?
  
  // Relations
  author        Admin       @relation(fields: [authorId], references: [id], onDelete: Cascade)
  category      Category?   @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  postTags      PostTag[]
}

model PostTag {
  postId String
  tagId  String
  post   Post   @relation(fields: [postId], references: [id], onDelete: Cascade)
  tag    Tag    @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@id([postId, tagId])
}

model Subscriber {
  id        String   @id @default(cuid())
  email     String   @unique
  name      String?
  status    String   @default("active")
  categories String[] @default([])
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// === MES-012 AI Tools Directory ===

enum ToolStatus {
  DRAFT
  REVIEW
  SCHEDULED
  PUBLISHED
  ARCHIVED
}

enum ToolPricing {
  FREE
  FREEMIUM
  PAID
  ENTERPRISE
}

enum ToolDifficulty {
  BEGINNER
  INTERMEDIATE
  ADVANCED
}

enum ToolAvailability {
  AVAILABLE
  BETA
  WAITLIST
  DISCONTINUED
}

enum ToolFeatureKind {
  FEATURE
  USE_CASE
  ADVANTAGE
  LIMITATION
}

enum ToolImageKind {
  LOGO
  COVER
  SCREENSHOT
}

model Tool {
  id                   String            @id @default(cuid())
  name                 String
  slug                 String            @unique
  shortDescription     String?
  fullDescription      String?           @db.Text
  websiteUrl           String?
  developer            String?
  platforms            String[]          @default([])
  availability         ToolAvailability  @default(AVAILABLE)
  pricing              ToolPricing       @default(FREEMIUM)
  difficulty           ToolDifficulty    @default(BEGINNER)
  recommendedFor       String[]          @default([])
  learningOutcomes     String[]          @default([])
  relatedArticleIds    String[]          @default([])
  relatedGuideIds      String[]          @default([])
  relatedToolIds       String[]          @default([])
  demoVideoUrl         String?
  featured             Boolean           @default(false)
  status               ToolStatus        @default(DRAFT)
  publishedAt          DateTime?
  seoTitle             String?
  seoDescription       String?
  focusKeyword         String?
  canonicalUrl         String?
  createdAt            DateTime          @default(now())
  updatedAt            DateTime          @updatedAt

  categories           ToolCategoryRelation[]
  topics               ToolTopicRelation[]
  features             ToolFeature[]
  images               ToolImage[]
  tags                 ToolTag[]

  @@index([status])
  @@index([pricing])
  @@index([featured])
  @@index([publishedAt])
}

model ToolCategoryRelation {
  toolId     String
  categoryId String
  tool       Tool     @relation(fields: [toolId], references: [id], onDelete: Cascade)
  category   Category @relation(fields: [categoryId], references: [id], onDelete: Cascade)

  @@id([toolId, categoryId])
}

model ToolTopicRelation {
  toolId  String
  topicId String
  tool    Tool  @relation(fields: [toolId], references: [id], onDelete: Cascade)
  topic   Topic @relation(fields: [topicId], references: [id], onDelete: Cascade)

  @@id([toolId, topicId])
}

model ToolFeature {
  id        String          @id @default(cuid())
  toolId    String
  label     String
  kind      ToolFeatureKind
  sortOrder Int             @default(0)
  tool      Tool            @relation(fields: [toolId], references: [id], onDelete: Cascade)

  @@index([toolId, kind, sortOrder])
}

model ToolImage {
  id        String        @id @default(cuid())
  toolId    String
  url       String
  alt       String?
  kind      ToolImageKind
  sortOrder Int           @default(0)
  tool      Tool          @relation(fields: [toolId], references: [id], onDelete: Cascade)

  @@index([toolId, kind])
}

model ToolTag {
  toolId String
  tagId  String
  tool   Tool @relation(fields: [toolId], references: [id], onDelete: Cascade)
  tag    Tag  @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@id([toolId, tagId])
}

// === MES-011 Admin AI Studio ===

enum AIGenerationType {
  ARTICLE
  IMAGE
  VIDEO
}

enum AIGenerationProvider {
  CLAUDE
  OPENAI
  GEMINI
  GROK
  DALLE
  VIDEO_TBD
  LOCAL_MOCK
}

enum AIGenerationStatus {
  PENDING
  RUNNING
  COMPLETED
  FAILED
  ACCEPTED
}

model AIGeneration {
