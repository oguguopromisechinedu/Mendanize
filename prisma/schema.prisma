// === MES-031 AI Knowledge Generation Pipeline ===

enum AIGenerationJobStatus {
  QUEUED
  PROCESSING
  COMPLETED
  FAILED
  MERGED
}

model AIGenerationJob {
  id                   String                 @id @default(cuid())
  question             String                 @db.Text
  /// Anonymized fingerprint of the asker ù never stores PublicUser.id (MES-031)
  sourceFingerprint    String?
  status               AIGenerationJobStatus  @default(QUEUED)
  articleId            String?
  errorMessage         String?
  createdAt            DateTime               @default(now())
  updatedAt            DateTime               @updatedAt
  article              Article?               @relation(fields: [articleId], references: [id], onDelete: SetNull)
