# App
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Database (PostgreSQL / Supabase)
#
# DATABASE_URL — app runtime (pooled)
#   Supabase: Dashboard → Connect → Transaction pooler (port 6543)
#   Append ?pgbouncer=true (and uselibpqcompat=true if using sslmode=require)
# DATABASE_URL="postgresql://postgres.[PROJECT_REF]:[PASSWORD]@aws-0-[REGION].pooler.supabase.com:6543/postgres?pgbouncer=true&sslmode=require&uselibpqcompat=true"
DATABASE_URL="postgresql://user:password@localhost:5432/mendanize?schema=public"

# DIRECT_URL — Prisma migrate / db push / introspect
# Free-tier note: db.[REF].supabase.co is often IPv6-only. Use the Session pooler
# (same host as DATABASE_URL, port 5432) for migrations from IPv4 networks.
# DIRECT_URL="postgresql://postgres.[PROJECT_REF]:[PASSWORD]@aws-1-[REGION].pooler.supabase.com:5432/postgres?sslmode=require&uselibpqcompat=true&connect_timeout=60"
# Pro/IPv4: direct host also works:
# DIRECT_URL="postgresql://postgres:[PASSWORD]@db.[PROJECT_REF].supabase.co:5432/postgres?sslmode=require&uselibpqcompat=true"
DIRECT_URL="postgresql://user:password@localhost:5432/mendanize?schema=public"

# Auth (Auth.js / NextAuth v5)
AUTH_SECRET=generate-with-openssl-rand-base64-32
# Local: http://localhost:3000
# Vercel Production: https://YOUR_DOMAIN (must match the deployed URL; do not leave localhost)
AUTH_URL=http://localhost:3000

# OAuth (optional — credentials auth works without these)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# Anthropic — primary Ask article / text provider when set
ANTHROPIC_API_KEY=
# Optional Ask model override
# ANTHROPIC_ASK_MODEL=claude-3-5-sonnet-latest

# OpenAI — Ask image generation (DALL·E) + article fallback
OPENAI_API_KEY=
# Optional model overrides
# OPENAI_STUDIO_MODEL=gpt-4o-mini
# OPENAI_ASK_MODEL=gpt-4o-mini
# OPENAI_ASK_IMAGE_MODEL=dall-e-3

# Reserved — not used (text SSOT is Anthropic + OpenAI only)
# GOOGLE_AI_API_KEY / XAI_API_KEY are intentionally unsupported

# Supabase (optional — media / storage integrations)
# NEXT_PUBLIC_SUPABASE_URL=
# NEXT_PUBLIC_SUPABASE_ANON_KEY=
# SUPABASE_SERVICE_ROLE_KEY=

# Stripe (subscription-ready)
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_PRO=
STRIPE_PRICE_TEAM=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=

# Rate limiting (optional — uses in-memory fallback if unset)
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Email / SMTP (optional — Notification Service placeholders)
# SMTP_HOST=
# SMTP_PORT=
# SMTP_USER=
# SMTP_PASS=
# EMAIL_FROM=

# Resend (optional — preferred production email transport when set)
# RESEND_API_KEY=

# Stripe Connect / org licensing (optional)
# STRIPE_CONNECT_PLATFORM_FEE_BPS=1000
# STRIPE_PRICE_ORG_TEAM_5=
# STRIPE_PRICE_ORG_TEAM_25=
# STRIPE_PRICE_ORG_TEAM_100=

# Optional model overrides
# ANTHROPIC_ASK_MODEL=claude-3-5-sonnet-latest
# ANTHROPIC_STUDIO_MODEL=
# ANTHROPIC_MODEL=
# OPENAI_STUDIO_MODEL=gpt-4o-mini
# OPENAI_ASK_MODEL=gpt-4o-mini
# OPENAI_ASK_IMAGE_MODEL=dall-e-3

# Optional runtime tuning
# DATABASE_POOL_MAX=12
# DATABASE_CONNECT_TIMEOUT_MS=20000
# DASHBOARD_HOME_TTL_MS=45000
# SMOKE_BASE_URL=http://localhost:3000
