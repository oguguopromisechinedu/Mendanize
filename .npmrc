; This project resolves its dependency tree with npm's legacy peer-dep
; behavior. CI installs already pass --legacy-peer-deps, and package-lock.json
; is generated the same way. Setting it here ensures every `npm ci`/`npm install`
; (including integrations that run a bare `npm ci`, e.g. the Prisma platform
; deploy) resolves the identical tree and stays in sync with the lockfile.
legacy-peer-deps=true
